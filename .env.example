# Tkxel AI Unlimited — environment variables
# Copy to .env.local for development; provision via your platform for prod.

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ai_unlimited?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""   # generate with: openssl rand -base64 32

# Google OAuth (Tkxel workspace credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bootstrap admin emails (comma-separated). On first sign-in these users are
# promoted to isAdmin=true. Allowed sign-in domains live in
# EventConfig.allowedEmailDomains, not here.
ADMIN_EMAILS=""

# Google Sheets agent sync. Paste the full service-account JSON key as a
# single-line string (escape inner quotes). The target sheet must be shared
# (Viewer) with the service account's client_email. Configure which sheet to
# read via /admin/config (agentSyncSheetId). Leave blank to disable the sync.
GOOGLE_SHEETS_SA_KEY_JSON=''
